<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: checks the cards for AnkiDroid against the real AnkiDroid on a
         device or an emulator (AnkiDroidCheck.kt says how to run it). -->
    <instrumentation
        android:name=".AnkiDroidCheck"
        android:label="AnkiDroid check"
        android:targetPackage="${applicationId}" />

    <!-- Debug builds only: plays the player on the mining settings screen with the real
         AnkiDroid beside it (MiningSettingsCheck.kt says how to run it). -->
    <instrumentation
        android:name=".MiningSettingsCheck"
        android:label="Mining settings check"
        android:targetPackage="${applicationId}" />
</manifest>
