<?xml version="1.0" encoding="utf-8"?>
<!-- Mining in the game (MiningSettingsActivity, docs/MINING.md). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="@dimen/column_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp"
            tools:ignore="UselessParent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kit_title"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/problem"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:textColor="@color/error"
                android:visibility="gone" />

            <!-- The game -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/kit_game_title" />

                <Switch
                    android:id="@+id/direct"
                    style="@style/SettingSwitch"
                    android:text="@string/kit_direct" />

                <TextView
                    style="@style/Note"
                    android:text="@string/kit_direct_note" />
            </LinearLayout>

            <!-- Anki -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/kit_anki_title" />

                <!-- Where cards go, on a device that has more than one place for them. -->
                <LinearLayout
                    android:id="@+id/anki_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- What only an AnkiConnect needs: its address, its key and the way to it. -->
                <LinearLayout
                    android:id="@+id/anki_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/anki_address"
                        style="@style/SettingField"
                    android:importantForAutofill="no"
                        android:hint="@string/kit_anki_address"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="textUri" />

                    <EditText
                        android:id="@+id/anki_key"
                        style="@style/SettingField"
                    android:importantForAutofill="no"
                        android:hint="@string/kit_anki_key"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="textPassword" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/anki_connect_button"
                            style="@style/PlainButton"
                            android:text="@string/kit_connect" />

                        <ProgressBar
                            android:id="@+id/anki_working"
                            style="@android:style/Widget.Material.ProgressBar.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/anki_check"
                    style="@style/Note"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/anki_problem"
                    style="@style/Note"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/anki_forget_key"
                    style="@style/PlainButton"
                    android:text="@string/kit_forget_key"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/deck_label"
                    style="@style/SettingLabel"
                    android:labelFor="@+id/deck"
                    android:text="@string/kit_deck" />

                <Spinner
                    android:id="@+id/deck"
                    style="@style/SettingSpinner" />

                <TextView
                    android:id="@+id/note_type_label"
                    style="@style/SettingLabel"
                    android:labelFor="@+id/note_type"
                    android:text="@string/kit_note_type" />

                <Spinner
                    android:id="@+id/note_type"
                    style="@style/SettingSpinner" />

                <Button
                    android:id="@+id/anki_fields"
                    style="@style/PlainButton"
                    android:text="@string/kit_fields"
                    android:visibility="gone" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@+id/anki_tags"
                    android:text="@string/kit_tags" />

                <EditText
                    android:id="@+id/anki_tags"
                    style="@style/SettingField"
                    android:importantForAutofill="no"
                    android:hint="@string/kit_tags_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textNoSuggestions" />

                <TextView
                    android:id="@+id/card_problem"
                    style="@style/Note"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/anki_note"
                    style="@style/Note"
                    android:layout_marginTop="8dp"
                    android:text="@string/kit_anki_note" />
            </LinearLayout>

            <!-- Dictionaries -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/kit_dictionaries_title" />

                <LinearLayout
                    android:id="@+id/dictionaries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/import_state"
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/import_progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/import_stop"
                    style="@style/PlainButton"
                    android:text="@string/kit_stop"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <!-- The dictionaries the kit offers, each with a button of its own. -->
                <LinearLayout
                    android:id="@+id/suggested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/import_file"
                    style="@style/PlainButton"
                    android:text="@string/kit_import_file" />

                <Button
                    android:id="@+id/import_address"
                    style="@style/PlainButton"
                    android:text="@string/kit_import_address" />

                <TextView
                    android:id="@+id/import_error"
                    style="@style/Note"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dictionary_problem"
                    style="@style/Note"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

                <TextView
                    style="@style/Note"
                    android:layout_marginTop="8dp"
                    android:text="@string/kit_dictionaries_note" />
            </LinearLayout>

            <!-- Word audio -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/kit_audio_title" />

                <EditText
                    android:id="@+id/audio_address"
                    style="@style/SettingField"
                    android:importantForAutofill="no"
                    android:hint="@string/kit_audio_address"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textUri" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/audio_check_button"
                        style="@style/PlainButton"
                        android:text="@string/kit_audio_check_keep" />

                    <ProgressBar
                        android:id="@+id/audio_working"
                        style="@android:style/Widget.Material.ProgressBar.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/audio_check"
                    style="@style/Note"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/audio_problem"
                    style="@style/Note"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/audio_forget"
                    style="@style/PlainButton"
                    android:text="@string/kit_forget_audio"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    style="@style/Note"
                    android:layout_marginTop="8dp"
                    android:text="@string/kit_audio_note" />
            </LinearLayout>

            <!-- The popup's look -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/kit_popup_title" />

                <TextView
                    style="@style/SettingLabel"
                    android:layout_marginTop="0dp"
                    android:labelFor="@+id/text_size"
                    android:text="@string/kit_text_size" />

                <Spinner
                    android:id="@+id/text_size"
                    style="@style/SettingSpinner" />

                <Switch
                    android:id="@+id/hide_tags"
                    style="@style/SettingSwitch"
                    android:text="@string/kit_hide_tags" />

                <Switch
                    android:id="@+id/compact"
                    style="@style/SettingSwitch"
                    android:text="@string/kit_compact" />
            </LinearLayout>

            <Button
                android:id="@+id/done"
                style="@style/PlainButton"
                android:layout_marginTop="12dp"
                android:text="@string/kit_done" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
